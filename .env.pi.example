# Шаблон для Raspberry Pi (docker-compose.pi.yml + webhook).
# Скопировать: cp .env.pi.example .env
# Дополнить секретами из .env.example (LLM, Langfuse, Alice — по необходимости).

# ─── Обязательно для бота ───────────────────────────────────
BOT_TOKEN=
# При ошибке ClientConnectorError к api.telegram.org — VPN на роутере или TELEGRAM_HTTP_PROXY=http://...
TELEGRAM_HTTP_PROXY=

# AmneziaWG (docker-compose.pi.yml): положить .vpn на Pi и выполнить:
#   bash scripts/pi_apply_amnezia_vpn.sh ~/config.vpn
# Появится deploy/amnezia-wg0.conf (не коммитить). Затем make docker-up-pi.

LLM_API_KEY=
# Qwen3 235B (Yandex Cloud AI Studio): gpt://<folder_id>/qwen3-235b-a22b-fp8/latest
LLM_MODEL=
LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1

# ─── Webhook (Telegram принимает только HTTPS) ───────────────
# Полный публичный префикс без пути (код добавит WEBHOOK_PATH):
#   https://bot.example.com
# Должен совпадать с тем, что отдаёт Caddy или Cloudflare Tunnel.
WEBHOOK_HOST=
WEBHOOK_PATH=/webhook
# HTTP за Caddy/Tunnel: 8080. Самоподпись на Pi: обычно 8443 + проброс порта на роутере
WEBHOOK_PORT=8080
# Вариант самоподписи (после bash scripts/pi-selfsigned-ssl.sh <публичный_IP>):
# WEBHOOK_PORT=8443
# WEBHOOK_HOST=https://ВАШ_ПУБЛИЧНЫЙ_IP:8443
# WEBHOOK_CERT_PATH=/app/ssl/cert.pem
# WEBHOOK_KEY_PATH=/app/ssl/private.key
WEBHOOK_CERT_PATH=
WEBHOOK_KEY_PATH=

# Для профиля caddy (свой домен → Pi, порты 80/443 на роутере):
#   WEBHOOK_DOMAIN=bot.example.com
#   WEBHOOK_HOST=https://bot.example.com
WEBHOOK_DOMAIN=

# Для профиля cf-tunnel: токен из Cloudflare Zero Trust → Networks → Tunnels
CLOUDFLARE_TUNNEL_TOKEN=

# STORAGE_BACKEND=memory задаётся в docker-compose.pi.yml.

# ─── Langfuse (облако) ─────────────────────────────────────
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Пока нет публичного HTTPS — polling (домашний Pi)
USE_WEBHOOK=false

CHAT_ENGINE=shopping_agent
LLM_PROVIDER=qwen_openai
MCP_SERVER_URL=https://mcp001.vkusvill.ru/mcp
MCP_SERVER_ENABLED=false
DEBUG=false
