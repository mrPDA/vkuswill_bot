#!/usr/bin/env bash
# Проверки перед push: тесты должны проходить
# Устанавливается: git config core.hooksPath .githooks

echo "🔍 Запуск тестов перед push..."

if command -v uv &> /dev/null; then
    uv run pytest -q --tb=short
    EXIT_CODE=$?
else
    python -m pytest -q --tb=short
    EXIT_CODE=$?
fi

if [ $EXIT_CODE -ne 0 ]; then
    echo ""
    echo "❌ Тесты не пройдены! Push отменён."
    echo "Исправьте ошибки и попробуйте снова."
    exit 1
fi

echo "✅ Все тесты пройдены. Push разрешён."

# Сканирование секретов (gitleaks) — только если установлен
if command -v gitleaks &> /dev/null; then
    echo "🔐 Сканирование секретов (gitleaks)..."
    gitleaks git --config .gitleaks.toml --no-banner 2>&1
    GITLEAKS_CODE=$?
    if [ $GITLEAKS_CODE -ne 0 ]; then
        echo ""
        echo "❌ Gitleaks обнаружил секреты в коммитах! Push отменён."
        echo "Используйте 'make secret-scan' для деталей."
        exit 1
    fi
    echo "✅ Секреты не обнаружены."
fi
